# ============================================================
#  .gitignore — Proyecto Bomberos USM
#  Solo se ignora lo que NO debe estar en el repositorio:
#  dependencias, artefactos de build y secretos locales.
# ============================================================

# --- Dependencias de Node ---
node_modules/
jspm_packages/

# --- Artefactos de compilación (generados por Vite) ---
# La carpeta dist/ se regenera con "npm run build" y no necesita
# estar en el repo; electron-builder la empaqueta por su cuenta.
dist/

# --- Artefactos del instalador (generados por electron-builder) ---
# La carpeta release/ contiene los .exe y archivos temporales de
# compilación. electron-builder los sube a GitHub Releases
# automáticamente; no es necesario commitearlos.
release/
out/
build/

# ⚠️  IMPORTANTE — NO ignorar *.yml en general:
# electron-updater necesita subir "latest.yml" a GitHub Releases.
# Si se ignora *.yml, el auto-updater deja de funcionar.
# Solo ignoramos los .yml que electron-builder genera localmente
# DENTRO de la carpeta release (ya cubierto arriba con release/).

# --- Bases de datos locales ---
# Los archivos .db pertenecen al userData de cada máquina,
# nunca deben subirse al repo.
*.db
*.db-journal
*.sqlite
*.sqlite3

# --- Variables de entorno y secretos ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Nota: .env.example SÍ se sube (contiene plantilla sin valores reales)

# --- Archivos del sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
logs/

# --- Cobertura de tests ---
coverage/