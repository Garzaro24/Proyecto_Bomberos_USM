# CONFIGURACIÓN DE ENTORNO DEL SISTEMA BOMBEROS USM
# Copia este archivo, renombralo como '.env' y llena los campos correspondientes.

# Puerto del servidor local (si aplica)
PORT=3000

# Clave secreta para encriptar datos locales de la bitácora (si usas crypto)
SECRET_ENCRYPTION_KEY=tu_clave_secreta_aqui

# Notas adicionales del entorno
NODE_ENV=development
